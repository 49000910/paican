  function testRuleInModal() {
    const input = document.getElementById('sn-rule-test-sn');
    const sn = normSn(input ? input.value : '');
    if (!sn) { setRuleMsg('请输入测试SN', '#d4380d'); return; }
    const tempRules = readRulesFromTable().filter(function(r) { return r.code && r.pattern; });
    let hit = null;
    for (let i = 0; i < tempRules.length; i++) {
      const r = tempRules[i];
      const value = normSn(r.pattern);
      const type = getEffectiveType(r.type, value);
      let ok = false;
      if (type === '包含') ok = sn.indexOf(value) >= 0;
      else if (type === '开头是') ok = sn.startsWith(value);
      else if (type === '等于') ok = sn === value;
      else if (type === '通配') ok = wildcardToRegExp(value).test(sn);
      if (ok) { hit = { code: r.code, type: type, pattern: r.pattern, index: i + 1 }; break; }
    }
    if (hit) setRuleMsg('SN规则测试命中：' + sn + ' => ' + hit.code + '，第 ' + hit.index + ' 行，' + hit.type + ' ' + hit.pattern, '#389e0d');
    else setRuleMsg('SN规则测试未命中：' + sn, '#d4380d');
  }

  async function testStrongFieldInModal() {
    const input = document.getElementById('sn-strong-test-text');
    const sn = normSn(input ? input.value : '');
    if (!sn) { setRuleMsg('请输入要查询的序列号SN', '#d4380d'); return; }
    setRuleMsg('查询中（接口一+接口二）...', '#d48806');

    try {
      let hit = null;
      let source = '';

      // 接口一
      for (let m = 0; m < EMS_MODES.length; m++) {
        const a = EMS_MODES[m][0];
        const b = EMS_MODES[m][1];
        let page = 1;
        let totalPages = 1;
        do {
          const j = await fetchEmsPageForStrongTest(sn, EMS_PAGE_SIZE, page, a, b);
          const text = JSON.stringify(j);
          const h = matchStrongFieldInText(text);
          if (h) { hit = h; source = '接口一'; break; }
          const vo = j && j.resultObjVO || {};
          const pageVO = vo.pageVO || {};
          totalPages = Number(pageVO.totalPages || 1);
          page++;
        } while (page <= totalPages);
        if (hit) break;
      }

      // 接口一没命中，查接口二
      if (!hit) {
        try {
          const apiUrl = 'https://w3.huawei.com/mes/qmgateway/com.huawei.supply.mes.mesplus.qm:mesqmmitrservice/mes/mitrservice/services/openapi/getSnAttr';
          const r2 = await fetch(apiUrl, {
            method: 'POST', credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ sn: sn })
          });
          const text2 = await r2.text();
          const h = matchStrongFieldInText(text2);
          if (h) { hit = h; source = '接口二'; }
        } catch(e) {}
      }

      if (hit) {
        setRuleMsg('✅ 强字段命中（' + source + '）：' + hit.field + ' => ' + hit.code, '#389e0d');
      } else {
        setRuleMsg('❌ 两个接口都未命中强字段', '#d4380d');
      }
    } catch(e) {
      setRuleMsg('查询异常：' + e.message, '#d4380d');
    }
  }

